# Empty means a self-contained demonstration. Never put secrets here.
VITE_API_BASE_URL=

# Public OSRM-compatible URL, without /route/v1/driving; never put credentials here.
# Empty uses the public demonstration service. Use an owned instance for production.
VITE_ROAD_ROUTING_URL=

# Public Photon-compatible geocoder. Defaults to photon.komoot.io demo service.
# Configure an owned service for production. No API secrets in frontend variables.
VITE_GEOCODER_URL=

# OSRM instance built with a FOOT profile, without /route/v1/foot.
# Empty uses FOSSGIS public pilot (1 request/second); use your own service at scale.
VITE_FOOT_ROUTING_URL=
